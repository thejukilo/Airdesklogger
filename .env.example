# PostgreSQL connection. On Vercel use a POOLED connection string so serverless
# functions do not exhaust direct connections. TLS is enabled automatically for
# any non-local host.
#
# Supabase (transaction pooler, for the app on Vercel; copy from the dashboard
# Connect dialog and fill the password):
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# For one-off migrate/seed from your machine, the session pooler (port 5432)
# is the better fit for DDL.
DATABASE_URL=postgresql://user:password@host:5432/airdesklogger

# Keep the pool tiny in serverless: each warm lambda holds its own pool.
PGPOOL_MAX=1

# Signs session tokens. At least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_JWT_SECRET=

# Wraps each signer's private key at rest. Exactly 32 bytes as 64 hex chars:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SIGNING_MASTER_KEY=

# Optional. Presenting this token in the x-admin-bootstrap header lets a
# registration request grant instructor/examiner/admin roles. Leave unset to
# keep self-registration pilot-only.
ADMIN_BOOTSTRAP_TOKEN=

# Base URL used to build one-time signing links. Defaults to the request host,
# so usually only needed if that is not the public URL.
APP_BASE_URL=https://log.airdeck.ch

# SMTP, used to email one-time signing links to external instructors. If unset,
# the link is still returned for the holder to share manually. SMTP_SECURE=true
# for implicit TLS on port 465; otherwise STARTTLS on 587.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=AirdeskLogger <no-reply@airdeck.ch>
