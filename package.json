{
  "name": "airdesklogger",
  "version": "0.1.0",
  "private": true,
  "description": "EASA-compliant digital flight logbook backend (AMC1 FCL.050)",
  "type": "module",
  "workspaces": [
    "web"
  ],
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:web": "npm run build -w airdesklogger-web",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.api.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "tsx src/db/migrate.ts",
    "seed:airports": "tsx src/db/seedAirports.ts",
    "gen:icao-types": "node scripts/genIcaoTypes.mjs",
    "demo": "tsx src/demo.ts"
  },
  "dependencies": {
    "hash-wasm": "^4.12.0",
    "jose": "^5.10.0",
    "nodemailer": "^6.9.14",
    "pdf-lib": "^1.17.1",
    "pg": "^8.12.0",
    "tz-lookup": "^6.1.25",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^6.4.15",
    "@types/pg": "^8.11.6",
    "@vercel/node": "^3.2.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
